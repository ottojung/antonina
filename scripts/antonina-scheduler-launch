#!/usr/bin/env python3
"""Delegate an open board issue; only the agent owns repositories and files."""
import argparse
import json
import os
import re
import secrets
import subprocess
import sys

ANTONINA = os.environ.get("ANTONINA_BIN", os.path.expanduser("~/.local/bin/antonina"))
# Antonina's runtime requires a startup cwd. This fixed launch context is not
# a checkout, a scheduler-selected workspace, or an ownership reservation.
START_DIR = "/workspace"


def run(args, check=True):
    return subprocess.run(args, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=check)


def require_open_issue(issue):
    result = run([ANTONINA, "board", "show", "--id", str(issue), "--page", "1", "--json"])
    record = json.loads(result.stdout)
    if record.get("state") != "open":
        raise SystemExit(f"refusing launch on non-open board issue #{issue}: {record.get('state')}")
    return record


def running_owners(issue):
    """Use agent identity rather than paths or repository discovery."""
    owners = []
    page = 1
    while True:
        result = json.loads(run([ANTONINA, "agent", "list", "--running", "--page",
                                 str(page), "--limit", "500", "--json"]).stdout)
        if result.get("unreadable"):
            raise SystemExit("agent inventory incomplete; refusing duplicate-risk launch")
        agents = result["agents"]
        for agent in agents:
            title = agent.get("title") or ""
            if re.search(r"(?<!\w)#" + str(issue) + r"\b", title):
                owners.append(agent["id"])
        if len(agents) < 500:
            break
        page += 1
    return owners


def agent_prompt(issue, prompt, agent_id):
    # The agent alone decides whether/where to clone and how to isolate edits.
    return (
        "AGENT OWNERSHIP: You, not the scheduler, own ALL repository and "
        "filesystem work for this board issue. This invocation begins in a "
        "generic runtime directory, NOT an issue checkout. Independently "
        "identify the correct remote from the issue, choose an isolated "
        "unique working directory for your own agent and issue, clone when "
        "needed, establish a branch, read project instructions, and manage "
        "commits, reviews, integration, deployment and handoff as permitted. "
        "Do not edit any existing shared checkout or assume the startup "
        "directory is your repository. Do not ask the scheduler to provision "
        "worktrees, create directories, register paths, or manage Git. "
        "If the repository is ambiguous, investigate it yourself. "
        f"Agent ID: {agent_id}. Issue #{issue.get('number')}: "
        f"{issue.get('title', '')}\n"
        f"Issue description:\n{issue.get('body') or ''}\n\n"
        f"Delegated task:\n{prompt}"
    )


def new_agent(agent_id, title):
    return run([ANTONINA, "agent", "new", "--id", agent_id,
                "--cwd", START_DIR, "--title", title, "--json"], check=False)


def cleanup_idle(agent_id):
    run([ANTONINA, "agent", "delete", "--id", agent_id, "--force"], check=False)


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--issue", required=True, type=int)
    parser.add_argument("--title", required=True)
    parser.add_argument("--summary", required=True)
    parser.add_argument("--prompt", required=True)
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args()

    require_open_issue(args.issue)
    owners = running_owners(args.issue)
    if owners:
        raise SystemExit(f"issue #{args.issue} already has live agent(s): {', '.join(owners)}")

    agent_id = None
    for _ in range(2):
        candidate = secrets.token_hex(6)
        proc = new_agent(candidate, args.title)
        if proc.returncode == 0:
            agent_id = candidate
            break
        if "already exists" not in (proc.stdout + proc.stderr).lower():
            sys.stderr.write(proc.stderr or proc.stdout)
            raise SystemExit(proc.returncode or 1)
    if agent_id is None:
        raise SystemExit("failed to allocate a unique agent id")

    # Both rechecks guard against stale queue and agent-state snapshots.
    try:
        current_issue = require_open_issue(args.issue)
        owners = running_owners(args.issue)
        if owners:
            raise SystemExit(f"issue #{args.issue} acquired another live owner: {', '.join(owners)}")
    except SystemExit:
        cleanup_idle(agent_id)
        raise

    started = run([
        ANTONINA, "agent", "run", "--id", agent_id, "--cwd", START_DIR,
        "--prompt", agent_prompt(current_issue, args.prompt, agent_id),
        "--detach", "--json",
    ], check=False)
    if started.returncode != 0:
        cleanup_idle(agent_id)
        sys.stderr.write(started.stderr or started.stdout)
        raise SystemExit(started.returncode or 1)

    try:
        require_open_issue(args.issue)
    except SystemExit:
        run([ANTONINA, "agent", "stop", "--id", agent_id], check=False)
        raise

    body = (
        "[scheduler-turn]\n"
        "state: working\n"
        f"summary: {args.summary}\n"
        f"resources: agent {agent_id}\n"
        "next: the delegated agent owns repository setup and all execution."
    )
    comment = run([
        ANTONINA, "board", "comment", "--id", str(args.issue), "--body", body,
        "--author", "openclaw@marceline-dev", "--json",
    ], check=False)
    print(json.dumps({
        "id": agent_id,
        "run": json.loads(started.stdout) if started.stdout.strip() else None,
        "comment_recorded": comment.returncode == 0
    }, separators=(",", ":")))
    if comment.returncode != 0:
        sys.stderr.write("worker started but board comment failed\n")
        sys.stderr.write(comment.stderr or comment.stdout)
        raise SystemExit(2)


if __name__ == "__main__":
    main()
