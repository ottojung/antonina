#!/usr/bin/env bash
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
bin_dir="${ANTONINA_BIN_DIR:-$HOME/.local/bin}"
skill_dir="${ANTONINA_SKILL_DIR:-$HOME/.openclaw/skills}"
restart="${ANTONINA_RESTART:-auto}"
mode="${1:---install}"
case "$mode" in
  --install|--check) ;;
  *) echo "usage: antonina-scheduler-deploy [--install|--check]" >&2; exit 2 ;;
esac
scripts=(antonina-orchestrator-loop antonina-orchestrator-restart
         antonina-orchestrator-turn antonina-orchestrator-model antonina-scheduler-issue
         antonina-scheduler-launch antonina-scheduler-snapshot)
skills=(antonina-orchestrator antonina-scheduler)
install_atomic() {
  local source="$1" target="$2" perm="$3" tmp
  mkdir -p "$(dirname "$target")"
  tmp="$(mktemp "$(dirname "$target")/.antonina-deploy.XXXXXX")"
  if ! install -m "$perm" "$source" "$tmp"; then
    rm -f "$tmp"
    return 1
  fi
  mv -f "$tmp" "$target"
}
verify_file() {
  if ! cmp -s "$1" "$2"; then
    echo "out of sync: $2" >&2
    return 1
  fi
}
for name in "${scripts[@]}"; do
  source="$root/scripts/$name"; target="$bin_dir/$name"
  if [[ "$mode" == --check ]]; then
    verify_file "$source" "$target"
  else
    install_atomic "$source" "$target" 755
  fi
done
# Deploy generic OpenCode integration only. Model preferences and historical
# comments live in host-local ~/.config/antonina/config.json: never overwrite it.
config_source="$root/config/opencode-openclaw.json"
config_target="${ANTONINA_OPENCODE_CONFIG:-$HOME/.config/opencode/openclaw.json}"
if [[ "$mode" == --check ]]; then
  verify_file "$config_source" "$config_target"
else
  install_atomic "$config_source" "$config_target" 600
fi
for name in "${skills[@]}"; do
  source="$root/skills/$name/SKILL.md"; target="$skill_dir/$name/SKILL.md"
  if [[ "$mode" == --check ]]; then
    verify_file "$source" "$target"
  else
    install_atomic "$source" "$target" 644
  fi
done
# The orchestrator skill links this companion file. Installing only SKILL.md
# leaves deployed guidance stale even when --check reports success.
resource_source="$root/skills/antonina-orchestrator/resources.md"
resource_target="$skill_dir/antonina-orchestrator/resources.md"
if [[ "$mode" == --check ]]; then
  verify_file "$resource_source" "$resource_target"
else
  install_atomic "$resource_source" "$resource_target" 644
fi
# A running orchestrator is not allowed to have a deployment-specific
# service entrypoint; it must use the same main-branch runner on every host.
# Do not create a new orchestrator where none already exists.
service_dir=/run/s6/legacy-services/antonina-orchestrator
if [[ -d "$service_dir" ]]; then
  service_source="$root/scripts/antonina-orchestrator-service-run"
  service_target="$service_dir/run"
  if [[ "$mode" == --check ]]; then
    verify_file "$service_source" "$service_target"
  else
    install_atomic "$service_source" "$service_target" 755
  fi
fi
if [[ "$mode" == --install && "$restart" != never &&
      -d /run/s6/legacy-services/antonina-orchestrator ]]; then
  "$bin_dir/antonina-orchestrator-restart"
fi
echo "Antonina scheduler ${mode#--} verified on $(hostname)"
