#!/bin/sh
snapshot="$("$HOME/.local/bin/antonina-scheduler-snapshot" 2>/dev/null || printf '{}')"
exec timeout -k 10s 90s "$HOME/.local/bin/opencode-openclaw" run --auto --model opencode/nemotron-3.5-lightning-free --variant low --dir /workspace/antonina "ANTONINA-SCHEDULER-TURN. A compact start-of-turn snapshot is included below. Use it immediately: reconcile any duplicate live cwd ownership first, then reason over the complete open-issue header list for project breadth. Do not rerun broad agent-list, board-list, board-feed, filesystem, or workspace-discovery scans unless this snapshot is missing or clearly stale. In particular NEVER use ls/find/globs over /workspace to discover a cwd. For the chosen candidate, read its body/newest comments with antonina board show, then obtain candidate cwd/worktree choices with antonina board resource list --issue ISSUE --page 1 --json. Re-check selected live ownership immediately before launch. Then read and obey $HOME/.openclaw/skills/antonina-scheduler/SKILL.md as the scheduling policy. Establish project breadth, then issue breadth, then justified project floors/depth. Do not implement project work yourself. If this snapshot shows a clear project-breadth gap and active pressure does not block work, this turn MUST NOT finish without either launching at least one missing-project owner or recording a precise blocker on the candidate issue. Launch useful detached agents only onto unoccupied cwd/worktrees, record exact ownership, and return promptly.

CURRENT_SNAPSHOT:
$snapshot"
