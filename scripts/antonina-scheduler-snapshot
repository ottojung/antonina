#!/usr/bin/env python3
import json
import os
import re
import subprocess
from datetime import datetime, timezone
from pathlib import Path

ANTONINA = os.path.expanduser("~/.local/bin/antonina")

def run(args, check=True):
    return subprocess.run(args, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=check)

def cli_json(*args):
    return json.loads(run([ANTONINA, *map(str, args)]).stdout)

def live_ids():
    proc = run(["pgrep", "-af", "opencode run --auto --title antonina-"], check=False)
    result = set()
    for line in proc.stdout.splitlines():
        m = re.search(r"--title\s+antonina-([^\s]+)", line)
        if m:
            result.add(m.group(1))
    return result

def read_cgroup(name):
    try:
        return (Path("/sys/fs/cgroup") / name).read_text().strip()
    except OSError:
        return ""

def kv_lines(text):
    out = {}
    for line in text.splitlines():
        parts = line.split()
        if len(parts) == 2:
            try:
                out[parts[0]] = int(parts[1])
            except ValueError:
                pass
    return out

def memory_snapshot():
    stat = kv_lines(read_cgroup("memory.stat"))
    events = kv_lines(read_cgroup("memory.events"))
    pressure = read_cgroup("memory.pressure").splitlines()
    return {
        "current": read_cgroup("memory.current") or None,
        "max": read_cgroup("memory.max") or None,
        "psi": pressure,
        "anon": stat.get("anon"),
        "file": stat.get("file"),
        "oom": events.get("oom"),
        "oom_kill": events.get("oom_kill"),
    }

running = cli_json("agent", "list", "--page", 1, "--limit", 500, "--running", "--json").get("agents", [])
live = live_ids()
agents = [
    {
        "id": a.get("id"),
        "title": a.get("title"),
        "cwd": a.get("cwd"),
    }
    for a in running
    if str(a.get("id")) in live
]

issues = cli_json("board", "list", "--state", "open", "--page", 1, "--json")
issue_headers = [
    {
        "number": i.get("number"),
        "title": (i.get("title") or "")[:120],
    }
    for i in issues
]

print(json.dumps({
    "live_agents": agents,
    "open_issue_count": len(issue_headers),
    "open_issues": issue_headers,
    "memory": memory_snapshot(),
}, separators=(",", ":")))
