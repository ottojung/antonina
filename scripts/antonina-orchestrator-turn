#!/bin/sh
snapshot="$("$HOME/.local/bin/antonina-scheduler-snapshot" 2>/dev/null || printf '{}')"
exec timeout -k 10s 75s "$HOME/.local/bin/opencode-openclaw" run --auto --model opencode-go/longcat-2.5-preview-free --variant low --dir /workspace/antonina "ANTONINA-SCHEDULER-TURN. A compact start-of-turn snapshot is included below. Use it immediately: reconcile any duplicate live cwd ownership first, then reason over the complete open-issue header list for project breadth. Do not rerun broad agent-list, board-list, board-feed, or workspace-discovery scans unless this snapshot is missing or clearly stale. Before any launch, re-check the chosen issue body/newest comments and the selected cwd/live ownership, then read and obey $HOME/.openclaw/skills/antonina-scheduler/SKILL.md as the scheduling policy. Establish project breadth, then issue breadth, then justified project floors/depth. Do not implement project work yourself. Launch useful detached agents only onto unoccupied cwd/worktrees, record exact ownership, and return promptly.

CURRENT_SNAPSHOT:
$snapshot"
