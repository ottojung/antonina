#!/bin/sh
set -u
interval="${ANTONINA_SCHEDULER_INTERVAL_SECONDS:-15}"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/antonina"
mkdir -p "$state_dir"

while :; do
  if ! pgrep -f 'opencode-openclaw.*ANTONINA-SCHEDULER-TURN' >/dev/null 2>&1; then
    "$HOME/.local/bin/antonina-orchestrator-turn" >>"$state_dir/orchestrator-turn.log" 2>&1 </dev/null &
  fi
  sleep "$interval"
done
