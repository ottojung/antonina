#!/usr/bin/env python3
"""Read useful board context, not just the latest scheduler launch chatter."""
import json
import os
import re
import subprocess
import sys

ANTONINA = os.environ.get("ANTONINA_BIN", os.path.expanduser("~/.local/bin/antonina"))
BODY_LIMIT = 10000
MESSAGE_LIMIT = 6000
SUBSTANTIVE_LIMIT = 12
ROUTINE_LIMIT = 2
MAX_PAGES = 12
PAGE_SIZE = 50


def is_routine_launch(message):
    body = (message.get("body") or "").lstrip()
    return body.startswith(("[scheduler-turn]", "[orchestrator]")) and re.search(
        r"(?m)^state:\s*working\s*$", body
    ) is not None


def compact_message(message):
    return {
        "author": message.get("author"),
        "createdAt": message.get("createdAt"),
        "body": (message.get("body") or "")[:MESSAGE_LIMIT],
    }


def handoff_claim(message):
    """A worker's assertion, never independent proof of delivery."""
    body = message.get("body") or ""
    if "[terminal-handoff]" not in body.lower():
        return None
    match = re.search(r"(?im)^state:\s*([^\r\n]+)", body)
    return {
        "author": message.get("author"),
        "createdAt": message.get("createdAt"),
        "claimed_state": match.group(1).strip()[:120] if match else "unspecified",
        "verified": False,
    }


def read_issue(issue):
    first = None
    substantive = []
    routine = []
    latest_handoff = None
    pages_read = 0
    for page in range(1, MAX_PAGES + 1):
        raw = subprocess.check_output(
            [ANTONINA, "board", "show", "--id", issue, "--page", str(page), "--json"],
            text=True,
        )
        item = json.loads(raw)
        if first is None:
            first = item
        elif item.get("number") != first.get("number"):
            raise RuntimeError("board pagination changed issue identity")
        messages = item.get("messages") or []
        pages_read += 1
        if not messages:
            break
        # Each board page is oldest-to-newest; page 1 is the newest page.
        for message in reversed(messages):
            if is_routine_launch(message):
                if len(routine) < ROUTINE_LIMIT:
                    routine.append(compact_message(message))
                continue
            if latest_handoff is None:
                latest_handoff = handoff_claim(message)
            if len(substantive) < SUBSTANTIVE_LIMIT:
                substantive.append(compact_message(message))
        if len(substantive) >= SUBSTANTIVE_LIMIT or len(messages) < PAGE_SIZE:
            break
    return {
        "number": first.get("number"),
        "state": first.get("state"),
        "title": first.get("title"),
        "updatedAt": first.get("updatedAt"),
        "body": (first.get("body") or "")[:BODY_LIMIT],
        "pages_read": pages_read,
        "newest_messages": substantive,
        "latest_routine_launches": routine,
        "latest_handoff_claim": latest_handoff,
        "handoff_is_verified": False,
    }


def main():
    args = [arg for arg in sys.argv[1:] if arg != "--json"]
    if len(args) != 2 or args[0] != "--issue" or not args[1].isdigit():
        raise SystemExit("usage: antonina-scheduler-issue --issue ISSUE [--json]")
    print(json.dumps(read_issue(args[1]), separators=(",", ":")))


if __name__ == "__main__":
    main()
