#!/usr/bin/env python3
"""Delegate an open board issue; only the agent owns repositories and files."""
import argparse
import json
import os
import re
import secrets
import socket
import socket
import subprocess
import sys
import time

ANTONINA = os.environ.get("ANTONINA_BIN", os.path.expanduser("~/.local/bin/antonina"))
# Antonina's runtime requires a startup cwd. This fixed launch context is not
# a checkout, a scheduler-selected workspace, or an ownership reservation.
START_DIR = "/workspace"


def run(args, check=True):
    return subprocess.run(args, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=check)



def require_open_issue(issue):
    result = run([ANTONINA, "board", "show", "--id", str(issue), "--page", "1", "--json"])
    record = json.loads(result.stdout)
    if record.get("state") != "open":
        raise SystemExit(f"refusing launch on non-open board issue #{issue}: {record.get('state')}")
    return record


def running_owners(issue):
    """Use agent identity rather than paths or repository discovery."""
    owners = []
    page = 1
    while True:
        result = json.loads(run([ANTONINA, "agent", "list", "--running", "--page",
                                 str(page), "--limit", "500", "--json"]).stdout)
        if result.get("unreadable"):
            raise SystemExit("agent inventory incomplete; refusing duplicate-risk launch")
        agents = result["agents"]
        for agent in agents:
            title = agent.get("title") or ""
            if re.search(r"(?<!\w)#" + re.escape(str(issue)) + r"(?![\w-])", title):
                owners.append(agent["id"])
        if len(agents) < 500:
            break
        page += 1
    return owners


def latest_progress_context(issue):
    """Unverified worker context from the latest board page, never proof of delivery."""
    messages = issue.get("messages") or []
    candidates = [m for m in messages if (m.get("body") or "").lstrip().startswith(
        ("[progress-checkpoint]", "[terminal-handoff]"))]
    if not candidates:
        return ""
    recent = max(candidates, key=lambda m: m.get("createdAt") or "")
    return (recent.get("body") or "")[:2500]


def agent_prompt(issue, prompt, agent_id):
    # The agent alone decides whether/where to clone and how to isolate edits.
    return (
        "AGENT OWNERSHIP: You, not the scheduler, own ALL repository and "
        "filesystem work for this board issue. This invocation begins in a "
        "generic runtime directory, NOT an issue checkout. Independently "
        "identify the correct remote from the issue, choose an isolated "
        "unique working directory for your own agent and issue, clone when "
        "needed, establish a branch, read project instructions, and manage "
        "commits, reviews, integration, deployment and handoff as permitted. "
        "Do not edit any existing shared checkout or assume the startup "
        "directory is your repository. Do not ask the scheduler to provision "
        "worktrees, create directories, register paths, or manage Git. "
        "If the repository is ambiguous, investigate it yourself. "
        "REPOSITORY IDENTITY: Confirm the actual project remote and root "
        "against the board and project instructions before any edits. "
        "Never treat the generic startup directory or an unrelated checkout "
        "as the project. If source cannot be resolved, report specific lookup "
        "attempts as a concrete blocker, not an invented artifact. "
        "CONSTRUCTIVE CONTINUATION: Do not treat difficulty or the inability "
        "to finish an entire issue in one invocation as a reason to exit. "
        "Produce a checkable increment: a useful lemma, minimal reproduction, "
        "failing or passing test, small implementation, review, or documented "
        "diagnostic that advances the full objective. Test and preserve it. "
        "If an approach fails, inspect the failure and try a narrower "
        "productive approach. Do not fabricate proof, success or empty "
        "commits. Only declare partial when recording concrete attempts, "
        "observations, and remaining work, or a genuine blocker. "
        "Never weaken project requirements merely to make tests pass. "
        "DURABLE CONTINUITY: Read the newest board comments and the preceding "
        "handoff/checkpoint before repeating an attempt. Verify claimed "
        "branches, commits and tests before trusting them. After useful "
        "progress or a material change of approach, append a concise "
        "[progress-checkpoint] comment with owner, repository, branch, "
        "artifact, validation, attempts and next; do so at meaningful "
        "milestones, not on a timer. A successor should be able to pick "
        "up where you left off. "

        f"Agent ID: {agent_id}. Issue #{issue.get('number')}: "
        f"{issue.get('title', '')}\n"
        f"Issue description:\n{issue.get('body') or ''}\n\n"        f"LAST UNVERIFIED CHECKPOINT (may be absent):\n"
        f"{latest_progress_context(issue) or 'none'}\n\n"

        "DURABLE TERMINAL HANDOFF: Before ending ANY run, post an Antonina "
        "board comment with this newline-delimited format:\n"
        "[terminal-handoff]\n"
        "state: <delivered | partial | blocked | needs-integration | awaiting-human>\n"
        "owner: agent-<your-id>\n"
        "repository: <verified project remote or unresolved>\n"
        "branch: <branch name or none>\n"
        "artifact: <commit/PR/path or none>\n"        "attempts: <concrete actions and observations, not vague inability>\n"

        "validation: <specific test/review evidence or not-run>\n"
        "next: <concrete remaining work or human decision>\n"
        "These are separate lines, not one comma-separated sentence. "
        "Only say delivered with a real artifact and validation; an exit "
        "code of zero is not evidence of completion. If unfinished, say "
        "partial/blocked and state what remains. Do not manufacture success. "
        "Keep the issue open if awaiting human review, but do not demand "
        "human action when autonomous review, integration or deployment "
        "can proceed.\n"
        f"Delegated task:\n{prompt}"
    )


def lease_command(action, issue, agent_id, token):
    return [ANTONINA, "board", "lease", action, "--issue", str(issue),
            "--agent", agent_id, "--host", socket.gethostname(),
            "--token", token, "--ttl", "600", "--json"]


def release_claim(issue, agent_id, token):
    return run(lease_command("release", issue, agent_id, token), check=False)


def start_lease_guard(issue, agent_id, token):
    command = [os.path.expanduser("~/.local/bin/antonina-scheduler-lease-guard"),
               "--issue", str(issue), "--agent", agent_id, "--token", token]
    log_path = os.path.join("/tmp", "antonina-lease-guard-" + token[:16] + ".log")
    with open(log_path, "a", encoding="utf-8") as log:
        child = subprocess.Popen(
            command, stdin=subprocess.DEVNULL, stdout=log, stderr=subprocess.STDOUT,
            start_new_session=True, close_fds=True,
        )
    time.sleep(0.1)
    if child.poll() is not None:
        raise RuntimeError("Lease guard failed to start: " + log_path)
    return child.pid


def new_agent(title):
    return run([ANTONINA, "agent", "new",
                "--cwd", START_DIR, "--title", title, "--json"], check=False)


def cleanup_idle(agent_id):
    run([ANTONINA, "agent", "delete", "--id", agent_id, "--force"], check=False)


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--issue", required=True)
    parser.add_argument("--title", required=True)
    parser.add_argument("--summary", required=True)
    parser.add_argument("--prompt", required=True)
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args()

    require_open_issue(args.issue)
    owners = running_owners(args.issue)
    if owners:
        raise SystemExit(f"issue #{args.issue} already has live agent(s): {', '.join(owners)}")

    proc = new_agent(args.title)
    if proc.returncode != 0:
        sys.stderr.write(proc.stderr or proc.stdout)
        raise SystemExit(proc.returncode or 1)
    agent_id = json.loads(proc.stdout)["id"]

    # A single atomic board commit excludes concurrent hosts before starting work.
    token = secrets.token_hex(24)
    acquired = run(lease_command("acquire", args.issue, agent_id, token), check=False)
    if acquired.returncode != 0:
        cleanup_idle(agent_id)
        sys.stderr.write(acquired.stderr or acquired.stdout)
        raise SystemExit(acquired.returncode or 1)

    # Both rechecks guard against stale queue and agent-state snapshots.
    try:
        current_issue = require_open_issue(args.issue)
        owners = running_owners(args.issue)
        if owners:
            raise SystemExit(f"issue #{args.issue} acquired another live owner: {', '.join(owners)}")
    except SystemExit:
        release_claim(args.issue, agent_id, token)
        cleanup_idle(agent_id)
        raise

    started = run([
        ANTONINA, "agent", "run", "--id", agent_id, "--cwd", START_DIR,
        "--prompt", agent_prompt(current_issue, args.prompt, agent_id),
        "--detach", "--json",
    ], check=False)
    if started.returncode != 0:
        release_claim(args.issue, agent_id, token)
        cleanup_idle(agent_id)
        sys.stderr.write(started.stderr or started.stdout)
        raise SystemExit(started.returncode or 1)

    # A detached guard renews the temporary shared claim, releases it on
    # termination and stops the worker if its lease is lost.
    try:
        guard_pid = start_lease_guard(args.issue, agent_id, token)
    except Exception as error:
        run([ANTONINA, "agent", "stop", "--id", agent_id], check=False)
        sys.stderr.write("Unable to supervise shared lease: " + str(error) + "\n")
        raise SystemExit(1)

    try:
        require_open_issue(args.issue)
    except SystemExit:
        run([ANTONINA, "agent", "stop", "--id", agent_id], check=False)
        raise

    # Close the duplicate-worktree race: the pre-run recheck has a TOCTOU window
    # between the snapshot and the run registering. After the run, confirm this
    # agent is the sole live owner of the issue; a concurrent launch or resume
    # that produced another live owner makes this agent a duplicate, so stop it.
    deadline = time.monotonic() + 10
    appeared = False
    while time.monotonic() < deadline:
        if agent_id in running_owners(args.issue):
            appeared = True
            break
        time.sleep(0.2)
    if appeared:
        concurrent = [owner for owner in running_owners(args.issue) if owner != agent_id]
        if concurrent:
            run([ANTONINA, "agent", "stop", "--id", agent_id], check=False)
            cleanup_idle(agent_id)
            raise SystemExit(
                f"issue #{args.issue} has concurrent live owner(s): {', '.join(concurrent)}; "
                f"stopped duplicate {agent_id}"
            )

    body = (
        "[scheduler-turn]\n"
        "state: working\n"
        f"summary: {args.summary}\n"
        f"resources: agent {agent_id}\n"
        "next: the delegated agent owns repository setup and all execution."
    )
    comment = run([
        ANTONINA, "board", "comment", "--id", str(args.issue), "--body", body,
        "--author", "openclaw", "--json",
    ], check=False)
    print(json.dumps({
        "id": agent_id,
        "run": json.loads(started.stdout) if started.stdout.strip() else None,
        "comment_recorded": comment.returncode == 0,
        "guard_pid": guard_pid
    }, separators=(",", ":")))
    if comment.returncode != 0:
        sys.stderr.write("worker started but board comment failed\n")
        sys.stderr.write(comment.stderr or comment.stdout)
        raise SystemExit(2)


if __name__ == "__main__":
    main()
